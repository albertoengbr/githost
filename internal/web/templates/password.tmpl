{{define "content"}}
<div class="page-head"><h1>Change password</h1></div>

<div class="card narrow">
  {{if .FormError}}<div class="flash flash-err">{{.FormError}}</div>{{end}}
  {{if .FormOK}}<div class="flash flash-ok">{{.FormOK}}</div>{{end}}
  <form method="post" action="/settings/password">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <label>Current password
      <input type="password" name="current" autocomplete="current-password" required>
    </label>
    <label>New password
      <input type="password" name="new_password" autocomplete="new-password"
             minlength="8" required>
    </label>
    <label>Confirm new password
      <input type="password" name="confirm_password" autocomplete="new-password"
             minlength="8" required>
    </label>
    <button type="submit">Change password</button>
  </form>
  <p class="muted">Changing your password signs you out of all devices.</p>
</div>
{{end}}
