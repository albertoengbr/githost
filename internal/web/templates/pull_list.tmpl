{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<div class="page-head">
  <div class="filter-group">
    <a class="button{{if eq .State ""}} is-active{{end}}" href="/{{$owner}}/{{$name}}/pulls">All</a>
    <a class="button{{if eq .State "open"}} is-active{{end}}" href="/{{$owner}}/{{$name}}/pulls?state=open">Open</a>
  </div>
  {{if .Username}}<a class="button" href="/{{$owner}}/{{$name}}/pulls/new">New PR</a>{{end}}
</div>

{{if .Pulls}}
<ul class="commit-list">
  {{range .Pulls}}
  <li class="commit-item">
    <div>
      <a class="commit-subject" href="/{{$owner}}/{{$name}}/pulls/{{.Number}}">{{.Title}}</a>
      {{if eq .State "merged"}}<span class="badge badge-public">merged</span>
      {{else if eq .State "closed"}}<span class="badge badge-archived">closed</span>
      {{else}}<span class="badge badge-public">open</span>{{end}}
      <p class="muted">#{{.Number}} · {{.Head}} → {{.Base}} · {{.Author}}</p>
    </div>
  </li>
  {{end}}
</ul>
{{template "pager" (dict "HasPrev" (gt .Page 1) "HasMore" .HasMore "PrevPage" (Sub .Page 1) "NextPage" (Add .Page 1) "PageURL" .PageURL)}}
{{else}}
{{template "empty-state" (dict "Icon" "🔀" "Title" (printf "No pull requests %s" (or .State "yet")) "Message" "Pull requests propose and review changes before they land.")}}
{{end}}
{{end}}
