{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<div class="page-head">
  <div class="filter-group">
    <a class="button{{if eq .State ""}} is-active{{end}}" href="/{{$owner}}/{{$name}}/issues">All</a>
    <a class="button{{if eq .State "open"}} is-active{{end}}" href="/{{$owner}}/{{$name}}/issues?state=open">Open</a>
    <a class="button{{if eq .State "closed"}} is-active{{end}}" href="/{{$owner}}/{{$name}}/issues?state=closed">Closed</a>
  </div>
  {{if .Username}}<a class="button" href="/{{$owner}}/{{$name}}/issues/new">New issue</a>{{end}}
</div>

{{if .Issues}}
<ul class="commit-list">
  {{range .Issues}}
  <li class="commit-item">
    <div>
      <a class="commit-subject" href="/{{$owner}}/{{$name}}/issues/{{.Number}}">{{.Title}}</a>
      {{if eq .State "closed"}}<span class="badge badge-archived">closed</span>
      {{else}}<span class="badge badge-public">open</span>{{end}}
      {{range .Labels}}<span class="label-badge"><img src="{{colordot .Color}}" alt="" width="10" height="10">{{.Name}}</span>{{end}}
      <p class="muted">#{{.Number}} · {{.CommentCount}} comments · {{.Author}}</p>
    </div>
  </li>
  {{end}}
</ul>
{{template "pager" (dict "HasPrev" (gt .Page 1) "HasMore" .HasMore "PrevPage" (Sub .Page 1) "NextPage" (Add .Page 1) "PageURL" .PageURL)}}
{{else}}
{{template "empty-state" (dict "Icon" "🐛" "Title" (printf "No issues %s" (or .State "yet")) "Message" "Issues track bugs, ideas and tasks for this repository.")}}
{{end}}
{{end}}
