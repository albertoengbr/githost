{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<div class="card">
  <h2>Commit <code>{{printf "%.12s" .Commit.Hash}}</code></h2>
  <p><strong>{{.Commit.Subject}}</strong></p>
  {{if .Commit.Body}}<pre class="commit-body">{{.Commit.Body}}</pre>{{end}}
  <p class="muted">
    {{.Commit.AuthorName}} <{{.Commit.AuthorEmail}}> · {{.Commit.AuthorTime}}
    {{if .Commit.IsMerge}} · merge of {{len .Commit.Parents}} parents{{end}}
  </p>
</div>

<div class="card">
  <h3>Changes</h3>
  {{if .Patch}}
  <pre class="code diff">{{.Patch}}</pre>
  {{else}}
  <p class="muted">No textual changes (merge commit).</p>
  {{end}}
</div>
{{end}}
