{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
<div class="repo-head">
  <h1><a href="/{{$owner}}">{{$owner}}</a> / <a href="/{{$owner}}/{{$name}}">{{$name}}</a>
    {{if eq .Repo.Visibility "private"}}<span class="badge badge-private">private</span>{{end}}
  </h1>
</div>
<nav class="tabs">
  <a class="tab" href="/{{$owner}}/{{$name}}">Code</a>
  <a class="tab" href="/{{$owner}}/{{$name}}/commits">Commits</a>
  <a class="tab" href="/{{$owner}}/{{$name}}/branches">Branches</a>
  <a class="tab" href="/{{$owner}}/{{$name}}/tags">Tags</a>
  {{if .CanManage}}<a class="tab" href="/{{$owner}}/{{$name}}/settings">Settings</a>{{end}}
</nav>

<div class="card">
  <h2>Commit <code>{{printf "%.12s" .Commit.Hash}}</code></h2>
  <p><strong>{{.Commit.Subject}}</strong></p>
  {{if .Commit.Body}}<pre class="commit-body">{{.Commit.Body}}</pre>{{end}}
  <p class="muted">
    {{.Commit.AuthorName}} <{{.Commit.AuthorEmail}}> · {{.Commit.AuthorTime}}
    {{if .Commit.IsMerge}} · merge of {{len .Commit.Parents}} parents{{end}}
  </p>
</div>

<div class="card">
  <h3>Changes</h3>
  {{if .Patch}}
  <pre class="code diff">{{.Patch}}</pre>
  {{else}}
  <p class="muted">No textual changes (merge commit).</p>
  {{end}}
</div>
{{end}}
