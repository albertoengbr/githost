{{define "content"}}
<div class="page-head"><h1>Access tokens</h1></div>

{{if .NewToken}}
<div class="card token-reveal">
  <h2>Your new token</h2>
  <p>Copy it now — it is stored as a hash and will never be shown again.</p>
  <pre class="code">{{.NewToken}}</pre>
</div>
{{end}}

<div class="card">
  <h2>Active tokens</h2>
  {{if .Tokens}}
  <table class="table">
    <tr><th>Name</th><th>Prefix</th><th>Scopes</th><th>Created</th><th></th></tr>
    {{range .Tokens}}
    <tr>
      <td>{{.Name}}</td>
      <td class="mono">{{.TokenPrefix}}…</td>
      <td>{{.Scopes}}</td>
      <td class="muted">{{timeago .CreatedAt}}</td>
      <td>
        <form method="post" action="/settings/tokens/revoke" class="inline-form">
          <input type="hidden" name="csrf" value="{{$.CSRF}}">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" class="linklike">revoke</button>
        </form>
      </td>
    </tr>
    {{end}}
  </table>
  {{else}}
  <p class="muted">No tokens yet.</p>
  {{end}}
</div>

<div class="card">
  <h2>Create a token</h2>
  <form method="post" action="/settings/tokens/create">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <label>Name <input name="name" placeholder="ci" required></label>
    <fieldset>
      <legend>Scopes</legend>
      <label class="checkbox"><input type="checkbox" name="scope_read" value="1" checked> repo:read (fetch / clone)</label>
      <label class="checkbox"><input type="checkbox" name="scope_write" value="1"> repo:write (push)</label>
    </fieldset>
    <button type="submit">Create token</button>
  </form>
</div>
{{end}}
