{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<section class="card">
  <div class="page-head">
    <div class="tree-path"><code>{{.Path}}</code> · {{bytes .Size}}</div>
    <div class="view-toggle">
      {{if .Rendered}}
      <a class="view-link active" href="?ref={{.Ref}}">Source</a>
      {{else if .CanRender}}
      <a class="view-link" href="?ref={{.Ref}}&render=1">Rendered</a>
      {{end}}
      <a class="view-link" href="/{{$owner}}/{{$name}}/raw/{{.Path}}?ref={{.Ref}}">raw</a>
    </div>
  </div>
  {{if .Binary}}
    <p class="muted">Binary file ({{bytes .Size}}). Use the raw link to download it.</p>
  {{else if .Truncated}}
    <p class="muted">File is {{bytes .Size}} and too large to preview. Use the raw link to view it fully.</p>
  {{else if .Rendered}}
    <div class="markdown-body">{{.Rendered}}</div>
  {{else}}
  <pre class="code code-lines">{{range .Lines}}<span class="line" id="L{{.N}}">{{.Text}}</span>
{{end}}</pre>
  {{end}}
</section>
{{end}}
