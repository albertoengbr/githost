{{define "content"}}
<div class="page-head"><h1>SSH keys</h1></div>
<div class="card">
  <h2>Registered keys</h2>
  {{if .Keys}}
  <table class="table">
    <tr><th>Title</th><th>Fingerprint</th><th></th></tr>
    {{range .Keys}}
    <tr>
      <td>{{.Title}}</td>
      <td class="mono">{{.Fingerprint}}</td>
      <td>
        <form method="post" action="/settings/keys/delete" class="inline-form">
          <input type="hidden" name="csrf" value="{{$.CSRF}}">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit" class="linklike">remove</button>
        </form>
      </td>
    </tr>
    {{end}}
  </table>
  {{else}}
  <p class="muted">No keys registered.</p>
  {{end}}
</div>

<div class="card">
  <h2>Add a key</h2>
  <p class="muted">Paste the contents of your <code>~/.ssh/id_ed25519.pub</code>
  (or <code>id_rsa.pub</code>) file.</p>
  <form method="post" action="/settings/keys/add">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <label>Title <input name="title" placeholder="laptop" required></label>
    <label>Public key <textarea name="key" rows="3" required></textarea></label>
    <button type="submit">Add key</button>
  </form>
</div>
{{end}}
