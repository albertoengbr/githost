{{define "content"}}
{{$id := .User.ID}}
<div class="page-head">
  <h1><span class="mono">{{.User.Username}}</span></h1>
</div>

{{if .FormError}}<div class="flash flash-err" role="status">{{.FormError}}</div>{{end}}
{{if .FormOK}}<div class="flash flash-ok" role="status">{{.FormOK}}</div>{{end}}

<div class="card">
  <h2>Account</h2>
  <form method="post" action="/admin/users/edit/{{$id}}">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <p class="muted">The username is fixed — it keys repository paths and git remotes.</p>
    <label>Email
      <input name="email" type="email" value="{{.User.Email}}" maxlength="254">
    </label>
    <label class="checkbox"><input type="checkbox" name="is_admin" value="1"
      {{if .User.IsAdmin}}checked{{end}}> Administrator</label>
    <button type="submit">Save account</button>
  </form>
</div>

<div class="card">
  <h2>Reset password</h2>
  <p class="muted">Setting a password invalidates every live session of this account.</p>
  <form method="post" action="/admin/users/edit/{{$id}}/password">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <label>New password
      <input name="new_password" type="password" minlength="8" autocomplete="new-password">
    </label>
    <label>Confirm new password
      <input name="confirm_password" type="password" minlength="8" autocomplete="new-password">
    </label>
    <button type="submit">Set password</button>
  </form>
</div>
{{end}}
