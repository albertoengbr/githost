{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<h2>Branches</h2>
{{if .Branches}}
<ul class="ref-list">
  {{range .Branches}}
  <li class="ref-item">
    <div>
      <a class="ref-name" href="/{{$owner}}/{{$name}}/commits?ref={{.Short}}">{{.Short}}</a>
      {{if eq .Short $.Repo.DefaultBranch}}<span class="badge">default</span>{{end}}
      <p class="muted">{{.Subject}} · {{timeago .When}}</p>
    </div>
    <a class="muted" href="/{{$owner}}/{{$name}}/tree?ref={{.Short}}">browse</a>
  </li>
  {{end}}
</ul>
{{else}}
{{template "empty-state" (dict "Icon" "🌿" "Title" "No branches yet" "Message" "The repository is empty — push a commit to create the default branch.")}}
{{end}}
{{end}}
