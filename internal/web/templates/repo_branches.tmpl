{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
<div class="repo-head">
  <h1><a href="/{{$owner}}">{{$owner}}</a> / <a href="/{{$owner}}/{{$name}}">{{$name}}</a>
    {{if eq .Repo.Visibility "private"}}<span class="badge badge-private">private</span>{{end}}
  </h1>
</div>
<nav class="tabs">
  <a class="tab" href="/{{$owner}}/{{$name}}">Code</a>
  <a class="tab" href="/{{$owner}}/{{$name}}/commits">Commits</a>
  <span class="tab active">Branches</span>
  <a class="tab" href="/{{$owner}}/{{$name}}/tags">Tags</a>
  {{if .CanManage}}<a class="tab" href="/{{$owner}}/{{$name}}/settings">Settings</a>{{end}}
</nav>

<h2>Branches</h2>
{{if .Branches}}
<ul class="ref-list">
  {{range .Branches}}
  <li class="ref-item">
    <div>
      <a class="ref-name" href="/{{$owner}}/{{$name}}/commits?ref={{.Short}}">{{.Short}}</a>
      {{if eq .Short $.Repo.DefaultBranch}}<span class="badge">default</span>{{end}}
      <p class="muted">{{.Subject}} · {{timeago .When}}</p>
    </div>
    <a class="muted" href="/{{$owner}}/{{$name}}/tree?ref={{.Short}}">browse</a>
  </li>
  {{end}}
</ul>
{{else}}
<p class="muted">No branches yet — the repository is empty.</p>
{{end}}
{{end}}
