{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<div class="card">
  <div class="latest-commit">
    <strong>{{.Issue.Title}}</strong>
    {{if eq .Issue.State "closed"}}<span class="badge badge-archived">closed</span>
    {{else}}<span class="badge badge-public">open</span>{{end}}
    {{range .Issue.Labels}}<span class="label-badge"><img src="{{colordot .Color}}" alt="" width="10" height="10">{{.Name}}</span>{{end}}
  </div>
  <div class="columns issue-columns">
    <div class="issue-main">
      <p class="muted">opened by {{.Issue.Author}} on {{.Issue.CreatedAt}}</p>
      <div class="markdown-body">{{.Issue.BodyHTML}}</div>

      <h3>Comments</h3>
      {{range .Comments}}
      <div class="card comment-card">
        <p class="muted">{{.Author}} · {{.CreatedAt}}</p>
        <div class="markdown-body">{{.BodyHTML}}</div>
      </div>
      {{end}}

      {{if .Username}}
      <form method="post" action="/{{$owner}}/{{$name}}/issues/{{.Issue.Number}}/comment">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <label>Add comment (Markdown)
          <textarea name="body" rows="4" required></textarea>
        </label>
        <button type="submit">Comment</button>
      </form>
      {{end}}
    </div>
    <aside class="issue-side">
      {{if .Username}}
      <form method="post" action="/{{$owner}}/{{$name}}/issues/{{.Issue.Number}}/state">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        {{if eq .Issue.State "open"}}
        <button type="submit" name="action" value="close">Close issue</button>
        {{else}}
        <button type="submit" name="action" value="reopen">Reopen issue</button>
        {{end}}
      </form>
      {{end}}

      {{if .Labels}}
      <h3>Labels</h3>
      {{range .Labels}}
      <form method="post" action="/{{$owner}}/{{$name}}/issues/{{.Issue.Number}}/label" class="label-toggle">
        <input type="hidden" name="csrf" value="{{$.CSRF}}">
        <input type="hidden" name="label_id" value="{{.ID}}">
        {{if index $.IssueLabels .ID}}
        <button type="submit" name="action" value="remove" class="label-badge is-button is-attached"><img src="{{colordot .Color}}" alt="" width="10" height="10">{{.Name}} ×</button>
        {{else}}
        <button type="submit" name="action" value="add" class="label-badge is-button"><img src="{{colordot .Color}}" alt="" width="10" height="10">{{.Name}} +</button>
        {{end}}
      </form>
      {{end}}
      {{end}}

      {{if .Events}}
      <h3>History</h3>
      {{range .Events}}
      <p class="muted event-line">{{.Actor}} {{.Kind}}{{if .Detail}} ({{.Detail}}){{end}} · {{.When}}</p>
      {{end}}
      {{end}}
    </aside>
  </div>
</div>
{{end}}
