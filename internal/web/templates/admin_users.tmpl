{{define "content"}}
<div class="page-head">
  <h1>Users</h1>
  <a class="button" href="/admin/users/new">New user</a>
</div>
<p class="muted">Accounts are provisioned by an administrator — public registration is off.</p>

{{if .FormError}}<div class="flash flash-err" role="status">{{.FormError}}</div>{{end}}

{{if .Users}}
<div class="card">
  <table class="table">
    <tr><th>User</th><th>Email</th><th>Role</th><th>Created</th><th>Repos</th><th></th></tr>
    {{range .Users}}
    <tr>
      <td><a class="mono" href="/{{.Username}}">{{.Username}}</a>{{if eq .ID $.CurrentID}} <span class="badge">you</span>{{end}}</td>
      <td>{{if .Email}}{{.Email}}{{else}}<span class="muted">—</span>{{end}}</td>
      <td>{{if .IsAdmin}}<span class="badge badge-public">admin</span>{{else}}<span class="badge">member</span>{{end}}</td>
      <td class="muted">{{.CreatedAt}}</td>
      <td class="muted">{{.RepoCount}}</td>
      <td>
        <div class="row-actions">
          <a class="button" href="/admin/users/edit/{{.ID}}">Edit</a>
          {{if ne .ID $.CurrentID}}
          <details class="row-confirm">
            <summary class="linklike">Delete</summary>
            <form method="post" action="/admin/users/delete/{{.ID}}" class="row-confirm-form">
              <input type="hidden" name="csrf" value="{{$.CSRF}}">
              <label class="checkbox"><input type="checkbox" required>
                Permanently remove <strong>{{.Username}}</strong></label>
              <button type="submit" class="button danger">Confirm delete</button>
            </form>
          </details>
          {{end}}
        </div>
      </td>
    </tr>
    {{end}}
  </table>
</div>
{{else}}
{{template "empty-state" (dict "Icon" "👥" "Title" "No users" "Message" "Create the first account with the button above.")}}
{{end}}
{{end}}
