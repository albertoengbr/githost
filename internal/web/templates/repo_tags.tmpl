{{define "content"}}
{{$owner := .Repo.Owner}}{{$name := .Repo.Name}}
{{template "repo-head" .}}

<div class="page-head">
  <h2>Tags</h2>
  {{if .CanManage}}<a class="button" href="/{{$owner}}/{{$name}}/releases/new">Draft a release</a>{{end}}
</div>
{{if .Tags}}
<ul class="ref-list">
  {{range .Tags}}
  <li class="ref-item">
    <div>
      <a class="ref-name" href="/{{$owner}}/{{$name}}/commits?ref={{.Short}}">{{.Short}}</a>
      <p class="muted">{{.Subject}} · {{timeago .When}}</p>
    </div>
  </li>
  {{end}}
</ul>
{{else}}
<p class="muted">No tags.</p>
{{end}}
{{end}}
